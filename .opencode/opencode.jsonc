{
  "$schema": "https://opencode.ai/config.json",
  // Configuración nativa V2. Sin modelo, proveedor ni plugins fijos.
  "permissions": [
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "architect", "effect": "ask" },
    { "action": "subagent", "resource": "requirements-analyst", "effect": "ask" },
    { "action": "subagent", "resource": "frontend", "effect": "ask" },
    { "action": "subagent", "resource": "backend", "effect": "ask" },
    { "action": "subagent", "resource": "database", "effect": "ask" },
    { "action": "subagent", "resource": "documenter", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "docs/ai-context/constitution.md", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" }
  ]
}
